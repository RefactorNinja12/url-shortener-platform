# Kopiera till .env och fyll i egna värden för lokal utveckling.
# .env är gitignorad — committa aldrig riktiga lösenord.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urlshortener

# Signeringsnyckel för JWT i auth-admin. Byt ut mot något slumpmässigt
# (t.ex. `openssl rand -base64 32`) — det här är bara en lokal dev-default.
JWT_SECRET=local-dev-secret-change-me-1234567890
